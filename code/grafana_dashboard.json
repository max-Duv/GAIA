{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source for GAIA metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "expr": "gaia_anomaly_detected == 1",
        "iconColor": "red",
        "name": "Anomaly Detected",
        "titleFormat": "Power anomaly",
        "textFormat": "Power exceeds threshold"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "GPU Module-Rail Power",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Power (W)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "watt"
        }
      },
      "targets": [
        {
          "expr": "gaia_gpu_power_watts",
          "legendFormat": "Total Power",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GPU Clock Frequency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Frequency (Hz)",
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "hertz"
        }
      },
      "targets": [
        {
          "expr": "gaia_gpu_clock_hz",
          "legendFormat": "GPU Clock",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Current Slew Rate |dI/dt|",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "A/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "gaia_gpu_current_slew_rate",
          "legendFormat": "|dI/dt|",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Anomaly Detection Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Normal", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "ANOMALY", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "gaia_anomaly_detected",
          "legendFormat": "Anomaly",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GPU Temperature",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          },
          "min": 20,
          "max": 100,
          "unit": "celsius"
        }
      },
      "targets": [
        {
          "expr": "gaia_gpu_temperature_celsius",
          "legendFormat": "GPU Temp",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Per-Channel Current",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Current (A)",
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "amp"
        }
      },
      "targets": [
        {
          "expr": "gaia_gpu_current_amps",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "GPU Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Utilization",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "gaia_gpu_utilization_ratio",
          "legendFormat": "GPU Util",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Telemetry Samples Collected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "gaia_telemetry_samples_total",
          "legendFormat": "Samples",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Sample Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "hertz"
        }
      },
      "targets": [
        {
          "expr": "rate(gaia_telemetry_samples_total[1m])",
          "legendFormat": "Hz",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1s",
  "schemaVersion": 39,
  "tags": ["gaia", "gpu", "power", "security"],
  "templating": { "list": [] },
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GAIA GPU Power Telemetry",
  "uid": "gaia-gpu-power",
  "version": 1
}
